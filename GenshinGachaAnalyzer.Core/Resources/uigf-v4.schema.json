{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "UIGF v4.0/v4.1/v4.2 普通原神 hk4e 离线约束；其他游戏与 hk4e_ugc 忽略。https://uigf.org/zh/standards/uigf.html",
  "type": "object",
  "required": [
    "info"
  ],
  "properties": {
    "info": {
      "type": "object",
      "required": [
        "export_timestamp",
        "export_app",
        "export_app_version",
        "version"
      ],
      "properties": {
        "export_timestamp": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            }
          ]
        },
        "export_app": {
          "type": "string"
        },
        "export_app_version": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "enum": [
            "v4.0",
            "v4.1",
            "v4.2"
          ]
        }
      }
    },
    "hk4e": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "uid",
          "timezone",
          "list"
        ],
        "properties": {
          "uid": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ]
          },
          "timezone": {
            "type": "integer"
          },
          "lang": {
            "type": "string",
            "enum": [
              "de-de",
              "en-us",
              "es-es",
              "fr-fr",
              "id-id",
              "it-it",
              "ja-jp",
              "ko-kr",
              "pt-pt",
              "ru-ru",
              "th-th",
              "tr-tr",
              "vi-vn",
              "zh-cn",
              "zh-tw"
            ]
          },
          "list": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "uigf_gacha_type",
                "gacha_type",
                "item_id",
                "time",
                "id"
              ],
              "properties": {
                "uigf_gacha_type": {
                  "type": "string",
                  "enum": [
                    "100",
                    "200",
                    "301",
                    "302",
                    "500"
                  ]
                },
                "gacha_type": {
                  "type": "string",
                  "enum": [
                    "100",
                    "200",
                    "301",
                    "302",
                    "400",
                    "500"
                  ]
                },
                "item_id": {
                  "type": "string"
                },
                "count": {
                  "type": "string"
                },
                "time": {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}$"
                },
                "name": {
                  "type": "string"
                },
                "item_type": {
                  "type": "string"
                },
                "rank_type": {
                  "type": "string"
                },
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 19,
                  "pattern": "^[0-9]+$"
                }
              }
            }
          }
        }
      }
    }
  }
}
