<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:GenshinGachaAnalyzer.WPF.Controls">
 <DataTemplate x:Key="ItemPortrait">
  <Viewbox Stretch="Uniform"><Border Width="52" Height="52" Background="{Binding QualityBackground}" CornerRadius="7" ClipToBounds="True">
   <Grid><TextBlock Text="{Binding Initial}" Style="{StaticResource ItemInitial}" FontSize="22" Foreground="{Binding QualityColor}" HorizontalAlignment="Center" VerticalAlignment="Center" /><Image Source="{Binding Icon}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" /></Grid>
  </Border></Viewbox>
 </DataTemplate>
 <DataTemplate x:Key="CollectionTile">
  <Button Width="106" Padding="0" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" Margin="0,0,10,12" ToolTip="{Binding Tooltip}" Command="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
   <StackPanel>
    <Border Background="{Binding QualityBackground}" CornerRadius="5,5,0,0" Height="90" ClipToBounds="True"><Grid><TextBlock Text="{Binding Initial}" Style="{StaticResource ItemInitial}" FontSize="30" Foreground="{Binding QualityColor}" HorizontalAlignment="Center" VerticalAlignment="Center" /><Image Source="{Binding Icon}" Margin="5" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" /><Border Background="#DAFFFFFF" CornerRadius="4" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="5" Padding="5,2"><TextBlock Text="{Binding CountText}" Foreground="#20252C" FontWeight="SemiBold" FontSize="14" /></Border></Grid></Border>
    <TextBlock Text="{Binding Name}" FontSize="14" HorizontalAlignment="Center" Margin="5,9,5,4" MaxWidth="94" TextTrimming="CharacterEllipsis" />
   </StackPanel>
  </Button>
 </DataTemplate>
 <DataTemplate x:Key="GoldListItem">
  <Border x:Name="GoldRow" Height="40" CornerRadius="6" ClipToBounds="True" Margin="0,0,0,4" Background="{DynamicResource PanelRaised}" ToolTip="{Binding Tooltip}">
   <Grid><Grid Margin="40,0,0,0"><controls:ProportionalProgress Value="{Binding PullValue, Mode=OneWay}" Maximum="{Binding Maximum}" Fill="{Binding PullBrush}" Opacity="0.2" IsHitTestVisible="False" /></Grid>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <ContentControl Width="40" Height="40" Content="{Binding}" ContentTemplate="{StaticResource ItemPortrait}" />
     <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{Binding QualityColor}" VerticalAlignment="Center" Margin="8,0" FontSize="14" TextTrimming="CharacterEllipsis" />
     <TextBlock Grid.Column="2" Text="{Binding CompactPullText}" Foreground="{Binding PullBrush}" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" Margin="6,0,9,0" />
    </Grid>
   </Grid>
  </Border><DataTemplate.Triggers><DataTrigger Binding="{Binding IsHighlighted}" Value="True"><Setter TargetName="GoldRow" Property="BorderBrush" Value="{DynamicResource Gold}"/><Setter TargetName="GoldRow" Property="BorderThickness" Value="2"/></DataTrigger></DataTemplate.Triggers>
 </DataTemplate>
 <DataTemplate x:Key="GoldGridItem">
  <Border x:Name="GoldTile" Width="52" Padding="4" Margin="0,0,5,7" CornerRadius="7" BorderThickness="2" BorderBrush="Transparent" ToolTip="{Binding Tooltip}"><StackPanel>
   <ContentControl Width="40" Height="40" Content="{Binding}" ContentTemplate="{StaticResource ItemPortrait}" />
   <TextBlock Text="{Binding CompactPullText}" FontSize="14" FontWeight="SemiBold" Foreground="{Binding PullBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
  </StackPanel></Border><DataTemplate.Triggers><DataTrigger Binding="{Binding IsHighlighted}" Value="True"><Setter TargetName="GoldTile" Property="BorderBrush" Value="{DynamicResource Gold}"/><DataTrigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="GoldTile" Storyboard.TargetProperty="Opacity" From="0.35" To="1" Duration="0:0:0.22" AutoReverse="True" RepeatBehavior="3x"/></Storyboard></BeginStoryboard></DataTrigger.EnterActions></DataTrigger></DataTemplate.Triggers>
 </DataTemplate>
 <DataTemplate x:Key="CountdownRow">
  <Border Padding="9,8" Margin="0,0,0,7" CornerRadius="8" Background="{DynamicResource PanelRaised}">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ItemPortrait}" Width="40" Height="40"/>
    <StackPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding LastPeriod}" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,4,0,0"/></StackPanel>
    <Button Grid.Column="2" Padding="8,8" ToolTip="{Binding Tooltip}" Content="{Binding DaysText, StringFormat=◷ {0}}" FontSize="13" Command="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
   </Grid>
  </Border>
 </DataTemplate>
</ResourceDictionary>
