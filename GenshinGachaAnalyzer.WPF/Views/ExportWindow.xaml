<Window x:Class="GenshinGachaAnalyzer.WPF.Views.ExportWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource AppWindow}" WindowStartupLocation="CenterOwner" Title="导出 UIGF" Width="570" Height="650" MinWidth="480" MinHeight="460">
 <Grid Margin="30"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,20"><TextBlock Text="EXPORT / UIGF" Style="{StaticResource Eyebrow}" /><TextBlock Text="带上您的完整档案" FontSize="26" FontWeight="SemiBold" Margin="0,12,0,18" /><TextBlock Text="文件只含标准字段，不含来源与分析结果。v2/v3 只能选一个账号；包含集录记录时请选择 v3.0 或 v4.x。" Style="{StaticResource MutedText}" /><ComboBox ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}" Width="180" HorizontalAlignment="Left" Margin="0,12,0,0" AutomationProperties.Name="选择 UIGF 导出版本" /></StackPanel>
  <Border Grid.Row="1" Style="{StaticResource Card}" Padding="18"><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Accounts}"><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Display}" IsChecked="{Binding IsSelected}" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Border>
  <StackPanel Grid.Row="2" Margin="0,20,0,0"><Button Content="UIGF-Org 标准说明  ↗" Click="UigfClick" Style="{StaticResource LinkButton}" /><TextBlock x:Name="ValidationText" Foreground="{DynamicResource Error}" FontSize="12" Margin="0,6,0,12" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="取消" IsCancel="True" Margin="0,0,12,0" /><Button Content="选择保存位置" Click="ConfirmClick" IsDefault="True" Style="{StaticResource PrimaryButton}" /></StackPanel></StackPanel>
 </Grid>
</Window>
