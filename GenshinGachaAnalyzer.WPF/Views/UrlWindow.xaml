<Window x:Class="GenshinGachaAnalyzer.WPF.Views.UrlWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource AppWindow}" Title="从祈愿 URL 获取" Width="700" Height="370" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
 <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="🔗 粘贴国服祈愿历史链接" FontSize="23" FontWeight="SemiBold"/><TextBlock Grid.Row="1" Text="从游戏祈愿历史中复制完整 URL。UID 从接口记录自动识别。链接仅在本次获取时使用，不保存、不写入日志。" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,14,0,16"/><TextBox x:Name="UrlText" Grid.Row="2" AcceptsReturn="False" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="国服祈愿 URL"/><TextBlock x:Name="ErrorText" Grid.Row="3" TextWrapping="Wrap" Foreground="{DynamicResource Error}" Margin="0,10,0,10"/><StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="取消" IsCancel="True" Margin="0,0,12,0"/><Button Content="↻ 开始获取" Click="ConfirmClick" Style="{StaticResource PrimaryButton}"/></StackPanel></Grid>
</Window>
