<Window x:Class="GenshinGachaAnalyzer.WPF.Views.ClearAccountWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="清空当前账号" Style="{StaticResource AppWindow}" Width="540" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
 <StackPanel Margin="28">
  <TextBlock Text="清空当前账号" Style="{StaticResource PageTitle}" FontSize="24" />
  <TextBlock Text="{Binding Summary}" Style="{StaticResource MutedText}" Margin="0,20,0,16" />
  <Border Style="{StaticResource Card}" Padding="16"><TextBlock Text="删除前会自动创建完整数据库备份，备份失败则不会清空。清空后可重新导入同一 UIGF 文件，所有记录将重新计为新增。" Style="{StaticResource MutedText}" /></Border>
  <TextBlock Text="输入完整 UID 以确认" Margin="0,22,0,10" />
  <TextBox Tag="完整 UID" Text="{Binding Confirmation, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="输入待清空账号 UID" />
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
   <Button Content="取消" IsCancel="True" Margin="0,0,12,0" />
   <Button Content="备份并清空" Style="{StaticResource DangerButton}" IsEnabled="{Binding CanConfirm}" Click="Confirm_Click" />
  </StackPanel>
 </StackPanel>
</Window>

