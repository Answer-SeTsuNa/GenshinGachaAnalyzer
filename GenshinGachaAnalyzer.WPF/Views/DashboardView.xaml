<UserControl x:Class="GenshinGachaAnalyzer.WPF.Views.DashboardView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:GenshinGachaAnalyzer.WPF.Controls" xmlns:infra="clr-namespace:GenshinGachaAnalyzer.WPF.Infrastructure">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
  <Grid Margin="0,0,12,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="✦  每一次相遇，都有迹可循" Foreground="{DynamicResource Gold}" FontSize="15" /><TextBlock Text="从档案第一条开始统计" Foreground="{DynamicResource Muted}" FontSize="12" Margin="16,0,0,0" VerticalAlignment="Center" /></StackPanel><Button Grid.Column="1" Content="◔ 比例" Command="{Binding RatioCommand}" Padding="18,8" ToolTip="查看已保存抽卡记录的五星比例与构成，不是出金概率" /></Grid>
  <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch"><ItemsControl ItemsSource="{Binding Pools}" MinWidth="1400" MinHeight="650" Height="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><controls:PoolCard /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
  <TextBlock Grid.Row="2" Text="{Binding Shell.SourceSummary, StringFormat=档案来源：{0} · 首次区间与未覆盖排期不参与平均。}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="4,12,0,0" TextWrapping="Wrap" />
  <Grid Grid.Row="1" Visibility="{Binding IsRatioOpen, Converter={StaticResource Visible}}" Panel.ZIndex="5"><Button infra:Motion.Interactive="False" Background="#660E1123" BorderThickness="0" Command="{Binding CloseRatioCommand}" />
   <Border Width="420" HorizontalAlignment="Right" Background="{DynamicResource Background}" Padding="22" Margin="0,0,12,0"><Border.RenderTransform><TranslateTransform x:Name="RatioOffset" /></Border.RenderTransform><Border.Style><Style TargetType="Border" BasedOn="{StaticResource Card}"><Style.Triggers><DataTrigger Binding="{Binding IsRatioOpen}" Value="True"><DataTrigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="32" To="0" Duration="0:0:0.24"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation><DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2" /></Storyboard></BeginStoryboard></DataTrigger.EnterActions></DataTrigger></Style.Triggers></Style></Border.Style><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <StackPanel><Grid><TextBlock Text="✦  五星比例" FontSize="22" FontWeight="SemiBold" /><Button Content="关闭" Command="{Binding CloseRatioCommand}" Style="{StaticResource LinkButton}" HorizontalAlignment="Right" /></Grid><TextBlock Text="{Binding GoldSummary}" Foreground="{DynamicResource Gold}" FontSize="14" Margin="0,12,0,12" />
     <ItemsControl ItemsSource="{Binding Pools}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{DynamicResource PanelRaised}" CornerRadius="8" Padding="11" Margin="0,0,0,7"><Grid><TextBlock Text="{Binding Name}" FontSize="13" /><TextBlock Text="{Binding GoldRateText}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Right" Foreground="{DynamicResource Gold}" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <TextBlock Text="上方：五星占该池已保存抽数的比例。&#10;下方：物品占已识别五星记录的比例。&#10;这是历史记录统计，不是未来出金概率。" Foreground="{DynamicResource Muted}" FontSize="12" LineHeight="21" Margin="0,4,0,16" /></StackPanel>
    <ListBox Grid.Row="1" ItemsSource="{Binding Shares}"><ListBox.ItemTemplate><DataTemplate><Border Padding="0,10" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="50" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><ContentControl Content="{Binding}" ContentTemplate="{StaticResource ItemPortrait}" Width="40" Height="40" /><StackPanel Grid.Column="1"><Grid><TextBlock Text="{Binding Name}" FontSize="14" /><TextBlock Text="{Binding ShareText}" Foreground="{DynamicResource Muted}" FontSize="12" HorizontalAlignment="Right" /></Grid><ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" Height="4" Margin="0,9,0,0" /></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
    <TextBlock Grid.Row="1" Text="尚无可统计的五星记录" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasShares, Converter={StaticResource Visible}, ConverterParameter=Invert}" />
   </Grid></Border>
  </Grid>
 </Grid>
</UserControl>


