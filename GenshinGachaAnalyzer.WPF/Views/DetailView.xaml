<UserControl x:Class="GenshinGachaAnalyzer.WPF.Views.DetailView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:GenshinGachaAnalyzer.WPF.Controls" xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
 <ScrollViewer VerticalScrollBarVisibility="Auto">
  <StackPanel>
   <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <Button Content="←  返回总览" Command="{Binding Shell.DashboardCommand}" Style="{StaticResource LinkButton}" Margin="0,0,28,0" />
    <ItemsControl Grid.Column="1" ItemsSource="{Binding Tabs}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Name}" Command="{Binding DataContext.Shell.SwitchPoolCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Definition}" Margin="0,0,8,0" Padding="12,10"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Gold}" /><Setter Property="BorderBrush" Value="{DynamicResource Gold}" /></DataTrigger></Style.Triggers></Style></Button.Style></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   </Grid>
   <Grid Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="POOL ANALYSIS" Style="{StaticResource Eyebrow}" /><TextBlock Text="{Binding Pool.Name}" Style="{StaticResource PageTitle}" Margin="0,8,0,0" /></StackPanel>
    <TextBlock Grid.Column="1" Text="{Binding Shell.UidText, StringFormat=UID  {0}}" Foreground="{DynamicResource Muted}" VerticalAlignment="Bottom" />
   </Grid>
   <UniformGrid Columns="4" Margin="0,0,-12,20">
    <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="20,16"><StackPanel><TextBlock Text="总抽数" Style="{StaticResource MutedText}" FontSize="12" /><TextBlock Text="{Binding Pool.TotalText}" FontSize="28" Margin="0,8,0,0" /></StackPanel></Border>
    <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="20,16"><StackPanel><TextBlock Text="五星数量" Style="{StaticResource MutedText}" FontSize="12" /><TextBlock Text="{Binding Pool.GoldText}" FontSize="28" Margin="0,8,0,0" /></StackPanel></Border>
    <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="20,16"><StackPanel><TextBlock Text="平均出金抽数" Style="{StaticResource MutedText}" FontSize="12" /><TextBlock Text="{Binding Pool.AverageText}" FontSize="28" Margin="0,8,0,0" /></StackPanel></Border>
    <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="20,16"><StackPanel>
     <TextBlock Text="欧非指数 · 最近一次" Style="{StaticResource MutedText}" FontSize="12" />
     <TextBlock Text="{Binding Pool.LuckText}" FontSize="28" Margin="0,8,0,0" Visibility="{Binding Pool.HasLuck, Converter={StaticResource Visible}}" />
     <TextBlock Text="基于您的历史记录，越低所用抽数越少" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,5,0,0" Visibility="{Binding Pool.HasLuck, Converter={StaticResource Visible}}" />
     <TextBlock Text="少于 10 次可统计出金，暂不显示" Style="{StaticResource MutedText}" FontSize="12" Margin="0,12,0,0" Visibility="{Binding Pool.HasLuck, Converter={StaticResource Visible}, ConverterParameter=Invert}" />
    </StackPanel></Border>
   </UniformGrid>
   <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,20">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="270" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="已保存抽数 / 硬保底" Style="{StaticResource MutedText}" FontSize="12" /><TextBlock Text="{Binding Pool.PityText}" FontSize="22" Foreground="{Binding Pool.Accent}" Margin="0,8,24,0" /><ProgressBar Maximum="{Binding Pool.HardPity}" Value="{Binding Pool.PityValue, Mode=OneWay}" Foreground="{Binding Pool.Accent}" Margin="0,12,24,0" /></StackPanel>
     <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Pool.Guarantee}" Margin="0,0,0,6" /><TextBlock Text="{Binding Pool.Note}" Style="{StaticResource MutedText}" FontSize="12" /><TextBlock Text="{Binding Pool.IntegrityNote}" Style="{StaticResource MutedText}" FontSize="12" /></StackPanel>
    </Grid>
   </Border>
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*" /><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <Border Style="{StaticResource Card}" Padding="22">
     <StackPanel>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="出金时间线" FontSize="17" FontWeight="SemiBold" /><Button Grid.Column="1" Content="全部记录" Command="{Binding ResetFilterCommand}" Style="{StaticResource LinkButton}" Padding="0" /></Grid>
      <TextBlock Text="{Binding FilterText}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,8,0,16" />
      <TextBlock Text="暂无五星记录" Style="{StaticResource MutedText}" Margin="0,18,0,18" Visibility="{Binding HasTimeline, Converter={StaticResource Visible}, ConverterParameter=Invert}" />
      <ListBox ItemsSource="{Binding Timeline}" Height="310" ScrollViewer.ScrollChanged="TimelineScrollChanged" AutomationProperties.Name="五星出金时间线">
       <ListBox.ItemTemplate><DataTemplate>
        <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="0,13,5,13">
         <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="86" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <TextBlock Text="{Binding PullText}" Foreground="{DynamicResource Gold}" FontSize="14" VerticalAlignment="Top" Margin="0,2,0,0" />
          <StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontSize="15" /><TextBlock Text="{Binding UpStatus}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,6,0,0" /><TextBlock Text="{Binding TimeText}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,5,0,0" /><TextBlock Text="{Binding SourceText}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,5,0,0" /><TextBlock Text="{Binding PercentileText}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,5,0,0" /></StackPanel>
         </Grid>
        </Border>
       </DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <Button Content="加载更多记录" Command="{Binding LoadMoreCommand}" Visibility="{Binding HasMore, Converter={StaticResource Visible}}" Style="{StaticResource LinkButton}" />
     </StackPanel>
    </Border>
    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="22">
     <StackPanel><TextBlock Text="出金抽数分布" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="点击柱子查看区间记录" Style="{StaticResource MutedText}" FontSize="12" Margin="0,8,0,12" />
      <lvc:CartesianChart Series="{Binding Series}" XAxes="{Binding XAxes}" YAxes="{Binding YAxes}" Background="{DynamicResource Panel}" Height="310" AnimationsSpeed="0:0:0.2" TooltipPosition="Top" LegendPosition="Hidden" AutomationProperties.Name="出金抽数直方图" />
      <ItemsControl ItemsSource="{Binding Pool.Analysis.Histogram}" Margin="0,12,0,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Label}" Command="{Binding DataContext.FilterCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Padding="9,6" FontSize="12" Margin="0,0,6,6" AutomationProperties.Name="{Binding Label, StringFormat=查看 {0} 抽区间}" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <TextBlock Text="从档案第一条开始累计，首个五星计入统计。&#10;星级缺失或区间异常时不推导。" Style="{StaticResource MutedText}" FontSize="12" Margin="0,12,0,0" />
     </StackPanel>
    </Border>
   </Grid>
   <Border Style="{StaticResource Card}" Padding="0" Margin="0,20,0,0"><controls:RecordTable DataContext="{Binding RecordsTable}"/></Border>
  </StackPanel>
 </ScrollViewer>
</UserControl>

