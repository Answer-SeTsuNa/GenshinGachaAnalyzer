<UserControl x:Class="GenshinGachaAnalyzer.WPF.Views.CountdownView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:GenshinGachaAnalyzer.WPF.Controls">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><ProgressBar IsIndeterminate="True" VerticalAlignment="Top" Panel.ZIndex="2" Visibility="{Binding IsLoading, Converter={StaticResource Visible}}" />
  <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="240" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding CoverageText}" FontSize="14" /><TextBlock Text="{Binding AsOfText}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,6,0,0" /><TextBlock Text="依据完整卡池时间线统计，与当前 UID 的抽卡记录无关。" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,6,0,0" /></StackPanel><TextBox Grid.Column="1" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Tag="搜索角色或武器" ToolTip="搜索角色或武器名称" AutomationProperties.Name="搜索 UP 复刻日历" /></Grid>
  <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"><ItemsControl ItemsSource="{Binding Sections}" MinWidth="1220" Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Padding="12" Margin="0,0,12,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" Margin="6,4,0,18" /><ListBox Grid.Row="1" ItemsSource="{Binding Items}" ItemTemplate="{StaticResource CountdownRow}" Tag="{Binding DataContext.SelectItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" ScrollViewer.VerticalScrollBarVisibility="Auto" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
  <Grid Grid.RowSpan="3" Panel.ZIndex="10" Background="#990C1524" Visibility="{Binding HasSelection, Converter={StaticResource Visible}}">
   <Border Style="{StaticResource Card}" MaxWidth="1020" Margin="32" Padding="18"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding HistoryTitle, StringFormat=◷  {0}}" FontSize="22" FontWeight="SemiBold"/><Button Grid.Column="1" Content="✕ 关闭" Command="{Binding CloseSelectionCommand}"/></Grid>
    <ListBox Grid.Row="1" ItemsSource="{Binding Histories}" ScrollViewer.VerticalScrollBarVisibility="Auto"><ListBox.ItemTemplate><DataTemplate>
     <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,16"><StackPanel><Grid Margin="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding PeriodText}" Foreground="{DynamicResource Gold}"/></Grid><Viewbox Stretch="Uniform"><controls:BannerImage FileName="{Binding BannerFile}" Width="1080" Height="533"/></Viewbox><StackPanel Orientation="Horizontal" Margin="16"><TextBlock Text="{Binding From, StringFormat=yyyy-MM-dd HH:mm}"/><TextBlock Text="  →  "/><TextBlock Text="{Binding To, StringFormat=yyyy-MM-dd HH:mm}"/></StackPanel></StackPanel></Border>
    </DataTemplate></ListBox.ItemTemplate></ListBox>
   </Grid></Border>
  </Grid>
 </Grid>
</UserControl>
