<UserControl x:Class="GenshinGachaAnalyzer.WPF.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:GenshinGachaAnalyzer.WPF.Controls">
 <ScrollViewer VerticalScrollBarVisibility="Auto">
  <StackPanel>
   <TextBlock Text="TRANSPARENCY, BY DESIGN" Style="{StaticResource Eyebrow}" /><TextBlock Text="设置与关于" Style="{StaticResource PageTitle}" Margin="0,12,0,24" />
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <StackPanel>
     <Border Style="{StaticResource Card}" Margin="0,0,0,20"><StackPanel>
      <TextBlock Text="✧ 主题" FontSize="18" FontWeight="SemiBold"/>
      <ComboBox ItemsSource="{Binding Shell.Styles}" SelectedItem="{Binding Shell.SelectedStyle}" Width="250" HorizontalAlignment="Left" Margin="0,16,0,12" AutomationProperties.Name="选择角色主题"/>
      <Border Background="{DynamicResource Selected}" CornerRadius="12" Height="110" Margin="0,0,0,16"><Grid><controls:ThemeEmblem Width="100" Height="100" Margin="8" HorizontalAlignment="Right"/><StackPanel Margin="18" VerticalAlignment="Center"><TextBlock Text="{Binding Shell.SelectedStyle.Name}" FontSize="22" Foreground="{DynamicResource Gold}" FontWeight="SemiBold"/></StackPanel></Grid></Border>
      <ComboBox ItemsSource="{Binding Shell.Themes}" SelectedItem="{Binding Shell.SelectedTheme}" Width="200" HorizontalAlignment="Left" Margin="0,0,0,16" AutomationProperties.Name="选择白天、夜晚或跟随系统"/>
      <CheckBox Content="亚克力背景模糊" IsChecked="{Binding Shell.Acrylic}" Margin="0,0,0,14"/>
      <CheckBox Content="半透明遮罩与面板" IsChecked="{Binding Shell.SemiTransparent}" Margin="0,0,0,14"/>
      <TextBlock Text="背景遮罩不透明度"/><Slider Minimum=".1" Maximum="1" Value="{Binding Shell.OverlayOpacity, Delay=120}" IsEnabled="{Binding Shell.SemiTransparent}" TickFrequency=".05" Margin="0,8,0,4" AutomationProperties.Name="背景遮罩不透明度"/><TextBlock Text="{Binding Shell.OverlayOpacity, StringFormat={}{0:P0}}" HorizontalAlignment="Right" Foreground="{DynamicResource Muted}"/>
      <TextBlock Text="玻璃面板不透明度" Margin="0,12,0,0"/><Slider Minimum=".35" Maximum="1" Value="{Binding Shell.PanelOpacity, Delay=120}" IsEnabled="{Binding Shell.SemiTransparent}" Margin="0,8,0,4" AutomationProperties.Name="玻璃面板不透明度"/><TextBlock Text="{Binding Shell.PanelOpacity, StringFormat={}{0:P0}}" HorizontalAlignment="Right" Foreground="{DynamicResource Muted}"/>
      <TextBlock Text="{Binding Shell.WallpaperText}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,18,0,10"/>
      <WrapPanel>
       <Button Content="▧ 选择本地壁纸" Command="{Binding Shell.SelectWallpaperCommand}" Margin="0,0,8,8"/>
       <Button Command="{Binding Shell.ResetWallpaperCommand}" Margin="0,0,0,8" AutomationProperties.Name="清空本地壁纸" ToolTip="清空壁纸设置，恢复主题背景；原图片保留。">
        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock Text="清空"/></StackPanel>
       </Button>
      </WrapPanel>
      <TextBlock Text="壁纸不透明度" Margin="0,8,0,0"/><Slider Minimum="0" Maximum="1" Value="{Binding Shell.WallpaperOpacity, Delay=120}" Margin="0,8,0,4"/><TextBlock Text="{Binding Shell.WallpaperOpacity, StringFormat={}{0:P0}}" HorizontalAlignment="Right" Foreground="{DynamicResource Muted}"/>
      <TextBlock Text="壁纸模糊强度" Margin="0,12,0,0"/><Slider Minimum="0" Maximum="40" Value="{Binding Shell.WallpaperBlur, Delay=120}" Margin="0,8,0,4"/><TextBlock Text="{Binding Shell.WallpaperBlur, StringFormat={}{0:F0}}" HorizontalAlignment="Right" Foreground="{DynamicResource Muted}"/>
      <TextBlock Text="界面缩放" Margin="0,16,0,8"/><ComboBox ItemsSource="{Binding Shell.DisplayScales}" SelectedItem="{Binding Shell.SelectedDisplayScale}" Width="200" HorizontalAlignment="Left" Margin="0,0,0,12"/>
      <TextBlock Text="默认跟随系统。Windows 11 22H2 及以上采用 Desktop Acrylic，系统关闭透明效果时使用系统回退。壁纸从本机读取，模糊只作用于背景，不影响文字清晰度。" Style="{StaticResource MutedText}" FontSize="12"/>
     </StackPanel></Border>
     <Border Style="{StaticResource Card}" Margin="0,0,0,20"><StackPanel><TextBlock Text="账号与数据管理" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="{Binding Shell.UidText, StringFormat=当前 UID：{0}}" Margin="0,18,0,14" /><Button Content="清空当前账号全部数据" Command="{Binding Shell.ClearAccountCommand}" Foreground="{DynamicResource Error}" HorizontalAlignment="Left" /><TextBlock Text="先生成完整数据库备份，再经完整 UID 确认清空。其他账号不受影响；清空后可重新导入同一文件。" Style="{StaticResource MutedText}" FontSize="12" Margin="0,14,0,0" /></StackPanel></Border>
     <Border Style="{StaticResource Card}" Margin="0,0,0,20"><StackPanel><TextBlock Text="国服游戏路径" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="{Binding Shell.GamePath}" Style="{StaticResource MutedText}" Margin="0,16,0,16" /><Button Content="手动指定游戏路径" Command="{Binding Shell.SelectGamePathCommand}" HorizontalAlignment="Left" /><TextBlock Text="选择含 YuanShen.exe 的目录。只读取日志与缓存，不修改游戏文件。不支持云原神和国际服。" Style="{StaticResource MutedText}" FontSize="12" Margin="0,16,0,0" /></StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="本地数据与备份" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="{Binding Shell.DatabasePath}" Style="{StaticResource MutedText}" Margin="0,16,0,16" /><WrapPanel><Button Content="打开数据目录" Command="{Binding Shell.OpenDataCommand}" Margin="0,0,12,8" /><Button Content="立即创建备份" Command="{Binding Shell.BackupCommand}" Margin="0,0,0,8" /></WrapPanel><TextBlock Text="导入、游戏更新和清空账号前自动备份至 backups。备份使用 SQLite 一致性快照。建议另存 UIGF 文件用于迁移。" Style="{StaticResource MutedText}" FontSize="12" Margin="0,12,0,0" /><TextBlock Text="{Binding Shell.LogDirectory}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,16,0,8" /><Button Content="打开导入日志目录" Command="{Binding Shell.OpenLogsCommand}" HorizontalAlignment="Left" /><TextBlock Text="写入日志记录新增、重复、冲突及每个差异字段的已有值和本次值，保存在本机 logs 目录。" Style="{StaticResource MutedText}" FontSize="12" Margin="0,10,0,0" /><TextBlock Text="手动备份：关闭工具后复制整个数据目录（包括可能存在的 WAL/SHM）。恢复：将整个原目录改名保留，在新建的空数据目录中把备份 .db 复制为 gacha.db，再启动。不要混用旧 WAL/SHM。" Style="{StaticResource MutedText}" FontSize="12" Margin="0,12,0,0" /></StackPanel></Border>
    </StackPanel>
    <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top" Padding="30">
     <StackPanel>
      <Image Source="/Resources/AppIcon.png" Width="72" Height="72" HorizontalAlignment="Left"/>
      <TextBlock Text="木偶原神抽卡分析工具" FontSize="23" FontWeight="SemiBold" Margin="0,24,0,12" />
      <TextBlock Text="{Binding Shell.ProductVersion, StringFormat=v{0}  /  Windows  /  .NET 10 LTS}" Style="{StaticResource MutedText}" FontSize="12" />
      <Border Height="1" Background="{DynamicResource Line}" Margin="0,26,0,26" />
      <TextBlock Text="以记录的严谨管理记录，&#10;以外衣的可视化呈现分析。" FontSize="17" LineHeight="29" />
      <TextBlock Text="数据永久留存，数据自由迁移。&#10;&#10;记录仅保存在您的电脑，不上传、不埋点、无账号体系。只有从游戏获取才连接国服官方接口；您主动点击的外部链接将使用浏览器打开。&#10;&#10;没有手动添加、修改单条抽卡记录的入口。允许备份后整账号清空，便于迁移和重新导入。统计依据已有数据，不显示精确出金概率，不推导武器定轨。" Style="{StaticResource MutedText}" Margin="0,22,0,22" />
      <TextBlock Text="UIGF 兼容性" FontSize="15" /><TextBlock Text="支持 v4.2 / v4.1 / v4.0 / v3.0 / v2.4 / v2.3 / v2.2 导入与导出；默认导出 v4.1。仅处理普通原神祈愿。旧版为单账号，v2.x 不含集录祈愿。导出不含来源、分析结果或私有字段。未宣称取得 UIGF 官方认证。" Style="{StaticResource MutedText}" FontSize="14" Margin="0,12,0,16" />
      <Button Content="UIGF-Org  ↗" Command="{Binding Shell.UigfLinkCommand}" Style="{StaticResource LinkButton}" />
      <Button Content="查看本地迁移指南  ↗" Command="{Binding Shell.MigrationCommand}" Style="{StaticResource LinkButton}" />
      <Button Content="MIT 开源协议  ↗" Command="{Binding Shell.LicenseCommand}" Style="{StaticResource LinkButton}" />
      <Button Content="项目开源仓库  ↗" Command="{Binding Shell.RepositoryCommand}" Style="{StaticResource LinkButton}" Visibility="{Binding Shell.HasRepository, Converter={StaticResource Visible}}" />
      <Border Height="1" Background="{DynamicResource Line}" Margin="0,20,0,20"/>
      <TextBlock Text="⌘ 开发者模式" FontSize="18" FontWeight="SemiBold"/>
      <CheckBox Content="操作报错时自动弹出诊断日志" IsChecked="{Binding Shell.DeveloperMode}" Margin="0,16,0,12"/>
      <Button Content="▤ 查看运行日志" Command="{Binding Shell.DeveloperLogCommand}" HorizontalAlignment="Left"/>
      <TextBlock Text="记录缓存定位步骤、异常类型与调用位置，祈愿凭据自动隐藏。导入冲突日志保存每条记录的差异，均只保存在本地。" Style="{StaticResource MutedText}" FontSize="12" Margin="0,14,0,20"/>
      <TextBlock Text="仓库地址待发布时配置" Style="{StaticResource MutedText}" FontSize="12" Visibility="{Binding Shell.HasRepository, Converter={StaticResource Visible}, ConverterParameter=Invert}" Margin="0,10,0,0" />
     </StackPanel>
    </Border>
   </Grid>
  </StackPanel>
 </ScrollViewer>
</UserControl>




