<UserControl x:Class="GenshinGachaAnalyzer.WPF.Views.PersonalView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:GenshinGachaAnalyzer.WPF.Controls" xmlns:charts="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
  <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,18" Height="200" ClipToBounds="True"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="420"/></Grid.ColumnDefinitions>
   <StackPanel Margin="28" VerticalAlignment="Center"><TextBlock Text="♡ 我的星轨" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="{Binding Shell.UidText}" FontSize="18" Foreground="{DynamicResource Gold}" Margin="0,12,0,0"/><TextBlock Text="{Binding RangeText}" Foreground="{DynamicResource Muted}" Margin="0,12,0,0" TextWrapping="Wrap"/></StackPanel>
   <controls:ThemeEmblem Grid.Column="1" Margin="20" Opacity=".65"/>
  </Grid></Border>
  <ItemsControl ItemsSource="{Binding Metrics}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
   <Border Style="{StaticResource Card}" Margin="0,0,12,12" Padding="20"><StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Icon}" Foreground="{DynamicResource Gold}" Margin="0,0,8,0"/><TextBlock Text="{Binding Label}" Foreground="{DynamicResource Muted}"/></StackPanel><TextBlock Text="{Binding Value}" FontSize="26" FontWeight="SemiBold" Margin="0,14,0,10"/><TextBlock Text="{Binding Note}" FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/></StackPanel></Border>
  </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  <Border Style="{StaticResource Card}" Margin="0,6,0,18"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="▦ 每月祈愿足迹" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/><ToggleButton x:Name="StandardFilter" Grid.Column="1" Style="{StaticResource FilterChip}" IsChecked="{Binding ExcludeStandard, Mode=TwoWay}" Margin="16,0,0,0" AutomationProperties.Name="过滤常驻"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE71C;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0" VerticalAlignment="Center"/><TextBlock Text="过滤常驻" FontSize="13" VerticalAlignment="Center"/></StackPanel></ToggleButton></Grid><charts:CartesianChart Series="{Binding Series}" XAxes="{Binding XAxes}" YAxes="{Binding YAxes}" Height="230" Margin="0,16,0,0" Visibility="{Binding HasMonths, Converter={StaticResource Visible}}"/><TextBlock Text="{Binding MonthsNote}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,10,0,0"/></StackPanel></Border>
  <ItemsControl ItemsSource="{Binding PoolCounts}" Margin="0,0,0,18"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="{Binding Label}" Foreground="{DynamicResource Muted}"/><TextBlock Text="{Binding Value}" FontSize="22" Margin="0,10,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="✦ 相遇最多的五星" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,18"/><ItemsControl ItemsSource="{Binding Favorites}" Tag="{Binding ShowFavoriteCommand}" ItemTemplate="{StaticResource CollectionTile}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl><TextBlock Text="这些指标描述已保存档案。从档案第一条累计抽数；未知 UP 不推导。记录空档不证明游戏内没有抽卡。" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,14,0,8"/><WrapPanel><Button Content="▣ 数据目录" Command="{Binding Shell.OpenDataCommand}" Margin="0,0,12,0"/><Button Content="⇧ 导出备份" Command="{Binding Shell.ExportCommand}"/><Button Content="⚙ 外观与设置" Command="{Binding Shell.SettingsCommand}" Margin="12,0,0,0"/></WrapPanel></StackPanel></Border>
 </StackPanel></ScrollViewer>
</UserControl>

