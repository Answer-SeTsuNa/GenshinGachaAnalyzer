<UserControl x:Class="GenshinGachaAnalyzer.WPF.Views.HistoryView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:GenshinGachaAnalyzer.WPF.Controls">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
  <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="190" /><ColumnDefinition Width="180" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
   <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=250}" Tag="搜索名称或日期" ToolTip="搜索祈愿、角色武器名称或日期" AutomationProperties.Name="搜索历史记录" Margin="0,0,12,0" />
   <ComboBox Grid.Column="1" ItemsSource="{Binding Pools}" SelectedItem="{Binding SelectedPool}" DisplayMemberPath="Name" Margin="0,0,12,0" AutomationProperties.Name="筛选卡池" />
   <ComboBox Grid.Column="2" ItemsSource="{Binding Eras}" SelectedItem="{Binding SelectedEra}" DisplayMemberPath="Name" AutomationProperties.Name="按大版本筛选时间线" />
   <TextBlock Grid.Column="3" Text="{Binding ResultText}" FontSize="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="20,0,4,0" />
  </Grid>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="370" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Card}" Padding="10"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <ItemsControl ItemsSource="{Binding DisplayModes}" Margin="2,2,0,12"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Name}" Style="{StaticResource SectionTab}" Padding="10,11" Command="{Binding DataContext.DisplayModeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <ListBox Grid.Row="1" ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}" ScrollViewer.VerticalScrollBarVisibility="Auto">
     <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Margin" Value="0,0,0,8" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" CornerRadius="10" Padding="12" BorderThickness="1" BorderBrush="{DynamicResource Line}" Background="{DynamicResource PanelRaised}"><ContentPresenter /></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource Selected}" /><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Gold}" /></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Gold}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
     <ListBox.ItemTemplate><DataTemplate><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="1" Text="{Binding CountText}" FontSize="12" Foreground="{DynamicResource Gold}" Margin="10,2,0,0" /></Grid><TextBlock Text="{Binding Period}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,7,0,8" /><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ItemsControl ItemsSource="{Binding GoldItems}" ItemTemplate="{StaticResource HistoryUpBadge}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl><ItemsControl Grid.Column="1" HorizontalAlignment="Right" ItemsSource="{Binding PurpleItems}" ItemTemplate="{StaticResource HistoryUpBadge}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl></Grid><WrapPanel Margin="0,3,0,0"><TextBlock Text="{Binding GoldCountText}" FontSize="12" Foreground="{DynamicResource QualityGold}" Margin="0,0,12,5" /><TextBlock Text="{Binding PurpleCountText}" FontSize="12" Foreground="{DynamicResource QualityPurple}" Margin="0,0,12,5" /><TextBlock Text="{Binding StandardCountText}" FontSize="12" Foreground="{DynamicResource Muted}" /></WrapPanel><TextBlock Text="{Binding DateText}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,6,0,0" /></StackPanel></DataTemplate></ListBox.ItemTemplate>
    </ListBox></Grid></Border>
   <ScrollViewer Grid.Column="2" Visibility="{Binding HasGroups, Converter={StaticResource Visible}}" VerticalScrollBarVisibility="Auto"><StackPanel>
    <Border Style="{StaticResource Card}" Margin="0,0,0,14" Padding="0"><StackPanel><Grid Margin="18,18,18,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding SelectedGroup.Name}" FontSize="22" FontWeight="SemiBold" /><TextBlock Text="{Binding SelectedGroup.DateText}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,7,0,12" /></StackPanel></Grid>
     <Viewbox Stretch="Uniform"><controls:BannerImage FileName="{Binding SelectedGroup.BannerFile}" Width="1080" Height="533" ClipToBounds="True" /></Viewbox>
     <TextBlock Text="{Binding SelectedGroup.SummaryText}" Foreground="{DynamicResource Gold}" FontSize="15" Margin="18,14,18,7" /><TextBlock Text="{Binding SelectedGroup.UpLabel}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="18,0,18,18" />
     <WrapPanel Margin="18,0,18,18"><Button Content="▦ 物品汇总" Command="{Binding ModeCommand}" CommandParameter="汇总" Margin="0,0,8,0"/><Button Content="▤ 原始记录" Command="{Binding ModeCommand}" CommandParameter="记录"/></WrapPanel>
    </StackPanel></Border>
    <Border Height="430" Style="{StaticResource Card}" Padding="18" Visibility="{Binding ShowSummary, Converter={StaticResource Visible}}"><Grid><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding SelectedGroup.HasRecords, Converter={StaticResource Visible}, ConverterParameter=Invert}"><TextBlock Text="无抽卡信息" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource Muted}" /><TextBlock Text="这段祈愿画卷等待您的相遇记录。" FontSize="14" Foreground="{DynamicResource Muted}" Margin="0,12,0,0" /></StackPanel><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding SelectedGroup.Sections}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" /><ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource CollectionTile}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Grid></Border>
    <Border Height="430" Style="{StaticResource Card}" Padding="0" Visibility="{Binding ShowSummary, Converter={StaticResource Visible}, ConverterParameter=Invert}"><Grid><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><DataGrid ItemsSource="{Binding Records}"><DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="Foreground" Value="{Binding QualityColor}"/></Style></DataGrid.RowStyle><DataGrid.Columns><DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*" /><DataGridTextColumn Header="星级" Binding="{Binding RankText}" Width="75" /><DataGridTextColumn Header="时间（UTC+8）" Binding="{Binding TimeText}" Width="180" /><DataGridTextColumn Header="来源" Binding="{Binding Source}" Width="100" /><DataGridTextColumn Header="记录 ID" Binding="{Binding RecordId}" Width="170" /></DataGrid.Columns></DataGrid><Grid Grid.Row="1" Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Content="← 上一页" Command="{Binding PreviousPageCommand}"/><TextBlock Grid.Column="1" Text="{Binding PageText}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" FontSize="12"/><Button Grid.Column="2" Content="下一页 →" Command="{Binding NextPageCommand}"/></Grid></Grid></Border>
   </StackPanel></ScrollViewer><TextBlock Grid.Column="2" Text="无抽卡信息" FontSize="20" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasGroups, Converter={StaticResource Visible}, ConverterParameter=Invert}" />
  </Grid>
 </Grid>
</UserControl>

