<Window x:Class="GenshinGachaAnalyzer.WPF.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:GenshinGachaAnalyzer.WPF.Controls" Title="木偶祈愿分析" Style="{StaticResource AppWindow}" Width="1440" Height="920" MinWidth="1120" MinHeight="620" WindowStartupLocation="CenterScreen" Icon="/Resources/App.ico">
 <Grid><controls:ThemeBackdrop/><Grid Margin="24,18,24,14"><Grid.LayoutTransform><ScaleTransform ScaleX="{Binding EffectiveScale}" ScaleY="{Binding EffectiveScale}" /></Grid.LayoutTransform>
  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
  <Grid Margin="2,0,2,18">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Source="/Resources/AppIcon.png" Width="44" Height="44" Margin="0,0,12,0"/><StackPanel><TextBlock Text="木偶祈愿分析" FontSize="26" FontWeight="SemiBold" /><TextBlock Text="木偶 · 把相遇留在星轨里" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,3,0,0" /></StackPanel></StackPanel>
   <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="20,0,0,0">
    <ComboBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}" Width="152" IsEnabled="{Binding IsIdle}" AutomationProperties.Name="选择原神 UID" Margin="0,0,12,0"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Display}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
    <Button Content="登录米游社获取" Command="{Binding FetchMiyousheCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" ToolTip="默认扫码，也可使用官方账号登录；无需启动游戏，登录信息不上传给开发者" />
    <Button Content="↻ 从游戏获取" Command="{Binding FetchCommand}" Margin="0,0,8,0" />
    <Button Content="🔗 URL" Command="{Binding FetchUrlCommand}" Margin="0,0,8,0" ToolTip="手动粘贴国服祈愿历史链接"/>
    <Button Content="↓  导入 UIGF" Command="{Binding ImportCommand}" Margin="0,0,8,0" />
    <Button Content="↑  导出 UIGF" Command="{Binding ExportCommand}" Margin="0,0,8,0" />
    <Button Content="⌫ 清空账号" Command="{Binding ClearAccountCommand}" Foreground="{DynamicResource Error}" Margin="0,0,8,0" ToolTip="先备份，再清空所选 UID 的全部记录。清空后可以重新导入。" />
    <Button Content="⚙ 设置" Command="{Binding SettingsCommand}" />
   </WrapPanel>
  </Grid>
  <Grid Grid.Row="1" Margin="0,0,0,18">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
   <ItemsControl ItemsSource="{Binding Sections}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Style="{StaticResource SectionTab}" Command="{Binding DataContext.SectionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Glyph}" Margin="0,0,7,0"/><TextBlock Text="{Binding Name}"/></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding ArchiveText}" FontSize="12" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right" /><TextBlock Text="{Binding UpdatedText}" FontSize="12" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right" Margin="0,5,0,0" /></StackPanel>
  </Grid>
  <controls:TransitionPresenter Grid.Row="2" Content="{Binding CurrentPage}" />
  <StackPanel Grid.Row="3" Margin="0,12,0,0">
   <ProgressBar IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource Visible}}" Height="3" Margin="0,0,0,8" />
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12" Margin="2,0,12,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Muted}" /><Style.Triggers><DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Error}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="⌘ 日志" Command="{Binding DeveloperLogCommand}" Visibility="{Binding DeveloperMode, Converter={StaticResource Visible}}" Style="{StaticResource LinkButton}" Margin="10,0"/><Button Content="重试" Command="{Binding RetryCommand}" Visibility="{Binding CanRetry, Converter={StaticResource Visible}}" Style="{StaticResource LinkButton}" Margin="10,0" /><Button Content="取消" Command="{Binding CancelCommand}" Visibility="{Binding IsBusy, Converter={StaticResource Visible}}" Style="{StaticResource LinkButton}" Margin="10,0" /><Button Content="打开导出文件夹" Command="{Binding OpenExportFolderCommand}" Visibility="{Binding HasExportPath, Converter={StaticResource Visible}}" Style="{StaticResource LinkButton}" /></StackPanel>
   </Grid>
  </StackPanel>
 </Grid></Grid>
</Window>


