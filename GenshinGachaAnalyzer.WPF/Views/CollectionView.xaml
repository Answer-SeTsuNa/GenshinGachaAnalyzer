<UserControl x:Class="GenshinGachaAnalyzer.WPF.Views.CollectionView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
  <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="240" /><ColumnDefinition Width="150" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding SummaryText}" FontSize="14" /><TextBlock Text="记录内获取次数，不推测命座、精炼或当前持有数量。" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,5,0,0" /></StackPanel><TextBox Grid.Column="1" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Tag="搜索角色或武器名称" ToolTip="搜索角色或武器名称" AutomationProperties.Name="搜索角色或武器" Margin="0,0,12,0" /><ComboBox Grid.Column="2" ItemsSource="{Binding Sorts}" SelectedItem="{Binding SelectedSort}" DisplayMemberPath="Name" AutomationProperties.Name="物品排序" /></Grid>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
   <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Sections}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Padding="22,18" Margin="0,0,0,16"><StackPanel><Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="{Binding Subtitle}" FontSize="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" /></Grid><ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource CollectionTile}" Tag="{Binding DataContext.SelectItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
   <TextBlock Text="没有符合条件的物品" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasItems, Converter={StaticResource Visible}, ConverterParameter=Invert}" />
   <Border Grid.Column="1" Style="{StaticResource Card}" Width="330" Margin="16,0,0,0" Padding="16" Visibility="{Binding HasSelection, Converter={StaticResource Visible}}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding SelectedItem.Name}" FontSize="20" FontWeight="SemiBold" /><Button Grid.Column="1" Content="关闭" Command="{Binding CloseSelectionCommand}" Style="{StaticResource LinkButton}" /></Grid><TextBlock Text="{Binding SelectedItem.CountText, StringFormat=记录内获取 {0}}" Foreground="{DynamicResource Gold}" Margin="0,10,0,10" /><TextBlock Text="{Binding SelectionNote}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,14" /></StackPanel><ListBox Grid.Row="1" ItemsSource="{Binding SelectedRecords}"><ListBox.ItemTemplate><DataTemplate><Border Padding="0,12" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" ToolTip="{Binding RecordId}"><StackPanel><TextBlock Text="{Binding TimeText}" FontSize="14" /><TextBlock Text="{Binding PoolName}" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,6,0,0" /><TextBlock Text="{Binding Source}" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,4,0,0" /></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border>
  </Grid>
 </Grid>
</UserControl>

