<Window x:Class="GenshinGachaAnalyzer.WPF.Views.AddAccountWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource AppWindow}" WindowStartupLocation="CenterOwner" Title="添加新账号" Width="540" Height="420" ResizeMode="NoResize">
 <StackPanel Margin="30"><TextBlock Text="添加一份新的本地档案" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,18" /><TextBlock Text="在游戏内切换至需要添加的账号并打开祈愿历史，或导入该账号的 UIGF 文件。UID 会从记录自动识别。" Style="{StaticResource MutedText}" Margin="0,0,0,26" /><Button Content="↻ 从当前游戏账号获取" Click="GameClick" Style="{StaticResource PrimaryButton}" Margin="0,0,0,12" /><Button Content="🔗 粘贴祈愿 URL" Click="UrlClick" Margin="0,0,0,12"/><Button Content="↓ 导入 UIGF 文件" Click="ImportClick" /><Button Content="取消" IsCancel="True" Style="{StaticResource LinkButton}" HorizontalAlignment="Center" Margin="0,12,0,0" /></StackPanel>
</Window>
