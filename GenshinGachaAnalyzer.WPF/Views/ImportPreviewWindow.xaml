<Window x:Class="GenshinGachaAnalyzer.WPF.Views.ImportPreviewWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource AppWindow}" WindowStartupLocation="CenterOwner" Title="UIGF 导入预检" Width="680" Height="670" ResizeMode="CanResize" MinWidth="580" MinHeight="520">
 <Grid Margin="30">
  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,22"><TextBlock Text="IMPORT / PREFLIGHT" Style="{StaticResource Eyebrow}" /><TextBlock Text="确认这份祈愿档案" FontSize="26" FontWeight="SemiBold" Margin="0,12,0,12" /><TextBlock Text="{Binding Version, StringFormat=文件版本  {0}}" Style="{StaticResource MutedText}" /><TextBlock Text="{Binding Summary}" Style="{StaticResource MutedText}" /></StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
   <StackPanel>
    <Border Style="{StaticResource Card}" Padding="20"><StackPanel><TextBlock Text="卡池记录数" FontSize="15" Margin="0,0,0,16" /><ItemsControl ItemsSource="{Binding Rows}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="125" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Uid}" Foreground="{DynamicResource Muted}" /><TextBlock Grid.Column="1" Text="{Binding Pool}" /><TextBlock Grid.Column="2" Text="{Binding Count, StringFormat={}{0:N0} 条}" Foreground="{DynamicResource Gold}" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
    <TextBlock Text="完整性检查" FontSize="15" Margin="0,22,0,12" />
    <TextBlock Text="✓  离线 Schema 及原神字段语义检查通过" Foreground="#8CCBC5" Margin="0,0,0,12" />
    <ItemsControl ItemsSource="{Binding Warnings}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource MutedText}" FontSize="14" Margin="0,0,0,12" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   </StackPanel>
  </ScrollViewer>
  <StackPanel Grid.Row="2" Margin="0,20,0,0"><TextBlock Text="按 ID 去重。已有记录保留不覆盖，写入前自动备份。" Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,14" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="取消" IsCancel="True" Margin="0,0,12,0" /><Button Content="确认导入" IsDefault="True" Click="ConfirmClick" Style="{StaticResource PrimaryButton}" /></StackPanel></StackPanel>
 </Grid>
</Window>
