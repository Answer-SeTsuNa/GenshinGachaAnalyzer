<Window x:Class="GenshinGachaAnalyzer.WPF.Views.MiyousheLoginWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource AppWindow}" Title="登录米游社获取" Width="900" Height="820" MinWidth="740" MinHeight="700" WindowStartupLocation="CenterOwner">
 <Grid Margin="28">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="登录米游社获取" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="无需启动游戏 · 仅用于获取你选择账号的祈愿记录" Style="{StaticResource MutedText}" Margin="0,8,0,18"/></StackPanel>
  <Border Grid.Row="1" Background="{DynamicResource Selected}" CornerRadius="12" Padding="18" Margin="0,0,0,18">
   <StackPanel><TextBlock Text="隐私优先 · 登录信息不上传给开发者" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource SelectedText}"/><TextBlock Text="登录由米哈游官方服务完成。密码只在官方页面填写；本工具不收集或保存密码。登录凭据仅用于本次获取，不写入设置、档案或诊断日志；祈愿记录仍只保存在本机。" TextWrapping="Wrap" Margin="0,9,0,0"/><TextBlock Text="网页登录使用独立隐私会话，官方网页及验证码的数据处理遵循米哈游相关政策。本工具没有接收登录信息的开发者服务器，不默认记住登录。" TextWrapping="Wrap" Style="{StaticResource MutedText}" FontSize="12" Margin="0,8,0,0"/></StackPanel>
  </Border>
  <Grid Grid.Row="2">
   <StackPanel x:Name="ConsentPanel" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560">
    <TextBlock Text="默认使用米游社 App 扫码确认" FontSize="22" FontWeight="SemiBold" TextAlignment="Center"/>
    <TextBlock Text="也可以切换至官方账号登录页。登录后，你可以核对昵称、UID 和服务器，再开始获取。取消会结束本次登录，不改变已有档案。" Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,16,0,24"/>
    <Button x:Name="ConsentButton" Content="了解并开始登录" Click="ConsentClick" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" AutomationProperties.Name="了解并开始米游社登录"/>
   </StackPanel>
   <Grid x:Name="LoginPanel" Visibility="Collapsed">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <WrapPanel Margin="0,0,0,12"><Button x:Name="QrButton" Content="扫码登录（推荐）" Click="QrClick" Margin="0,0,12,0"/><Button x:Name="AccountButton" Content="账号登录" Click="AccountClick"/><TextBlock Text="米哈游官方认证" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="16,0,0,0"/></WrapPanel>
    <Grid Grid.Row="1">
     <StackPanel x:Name="QrPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
      <Border Background="White" Padding="18" CornerRadius="12"><Image x:Name="QrImage" Width="220" Height="220" AutomationProperties.Name="米游社登录二维码"/></Border>
      <TextBlock Text="打开米游社 App 扫一扫，并在手机上确认登录" TextAlignment="Center" Margin="0,16,0,12"/>
      <Button Content="刷新二维码" Click="QrClick" HorizontalAlignment="Center" Style="{StaticResource LinkButton}"/>
     </StackPanel>
     <Grid x:Name="BrowserPanel" Visibility="Collapsed" Background="White"/>
    </Grid>
   </Grid>
   <StackPanel x:Name="RolePanel" Visibility="Collapsed" VerticalAlignment="Center">
    <TextBlock Text="登录成功" FontSize="24" FontWeight="SemiBold"/>
    <TextBlock Text="将为以下原神账号获取祈愿记录" Style="{StaticResource MutedText}" Margin="0,10,0,0"/>
    <Border Background="{DynamicResource Selected}" CornerRadius="12" Padding="24" Margin="0,20,0,16">
     <StackPanel>
      <TextBlock x:Name="RoleNickname" Text="{Binding SelectedItem.Nickname, ElementName=RolePicker}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource SelectedText}"/>
      <TextBlock x:Name="RoleUid" Text="{Binding SelectedItem.Uid, ElementName=RolePicker, StringFormat=UID：{0}}" FontSize="20" Margin="0,14,0,8"/>
      <TextBlock x:Name="RoleServer" Text="{Binding SelectedItem.RegionName, ElementName=RolePicker, StringFormat=服务器：{0}}"/>
     </StackPanel>
    </Border>
    <ComboBox x:Name="RolePicker" DisplayMemberPath="Display" Margin="0,0,0,18" AutomationProperties.Name="选择米游社绑定的原神账号"/>
    <WrapPanel><Button x:Name="FetchButton" Content="开始获取祈愿记录" Click="FetchClick" Style="{StaticResource PrimaryButton}" Margin="0,0,12,0"/><Button Content="换一个登录账号" Click="QrClick"/></WrapPanel>
   </StackPanel>
  </Grid>
  <TextBlock x:Name="StatusText" Grid.Row="3" Text="开始前请阅读上方隐私说明。" Style="{StaticResource MutedText}" Margin="0,18,0,12" AutomationProperties.LiveSetting="Polite"/>
  <Button Grid.Row="4" Content="取消并关闭" IsCancel="True" HorizontalAlignment="Right" Click="CancelClick"/>
 </Grid>
</Window>
