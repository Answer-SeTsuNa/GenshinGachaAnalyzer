<Window x:Class="GenshinGachaAnalyzer.WPF.Views.WriteResultWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource AppWindow}" WindowStartupLocation="CenterOwner" Title="导入结果与冲突详情" Width="950" Height="750" MinWidth="740" MinHeight="580">
 <Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="✓  写入已完成" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,16" /><TextBlock Text="{Binding Summary}" Foreground="{DynamicResource Gold}" /><TextBlock Text="新增记录已完整提交。重复与冲突保留已有记录；请选择一行查看具体字段差异。" Style="{StaticResource MutedText}" Margin="0,12,0,16" /></StackPanel>
  <Grid Grid.Row="1" Visibility="{Binding HasConflicts, Converter={StaticResource Visible}}"><Grid.RowDefinitions><RowDefinition Height="1.1*" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><DataGrid x:Name="Conflicts" ItemsSource="{Binding Details}" SelectedIndex="0" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="记录 ID" Binding="{Binding Id}" Width="190" /><DataGridTextColumn Header="冲突原因" Binding="{Binding Reason}" Width="*" /><DataGridTextColumn Header="差异字段" Binding="{Binding Fields}" Width="200" /></DataGrid.Columns></DataGrid><TextBlock Grid.Row="1" Text="已有内容 / 本次导入内容" FontWeight="SemiBold" Margin="0,14,0,10" /><Border Grid.Row="2" Style="{StaticResource Card}" Padding="14"><ScrollViewer VerticalScrollBarVisibility="Auto"><TextBox Text="{Binding SelectedItem.DetailText, ElementName=Conflicts, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Background="Transparent" BorderThickness="0" /></ScrollViewer></Border></Grid>
  <StackPanel Grid.Row="1" Visibility="{Binding HasConflicts, Converter={StaticResource Visible}, ConverterParameter=Invert}" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="本次没有冲突" FontSize="22" Foreground="{DynamicResource Gold}" /></StackPanel>
  <Grid Grid.Row="2" Margin="0,18,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><StackPanel><TextBlock Text="{Binding LogPath}" Style="{StaticResource MutedText}" FontSize="12" /><TextBlock Text="{Binding LogWarning}" Foreground="{DynamicResource Error}" TextWrapping="Wrap" /></StackPanel><Grid Grid.Row="1" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><WrapPanel Visibility="{Binding HasLog, Converter={StaticResource Visible}}"><Button Content="查看完整日志" Command="{Binding OpenLogCommand}" Margin="0,0,10,0" /><Button Content="打开日志目录" Command="{Binding OpenLogFolderCommand}" /></WrapPanel><Button Grid.Column="1" Content="完成" IsDefault="True" IsCancel="True" Style="{StaticResource PrimaryButton}" /></Grid></Grid>
 </Grid>
</Window>

