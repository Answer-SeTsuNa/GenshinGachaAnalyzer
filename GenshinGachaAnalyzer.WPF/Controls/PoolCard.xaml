<UserControl x:Class="GenshinGachaAnalyzer.WPF.Controls.PoolCard" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:GenshinGachaAnalyzer.WPF.Controls">
 <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,12,0">
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
   <Border Background="{DynamicResource PanelRaised}" CornerRadius="12,12,0,0" Padding="14,11" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><ToggleButton Content="{Binding Name}" IsChecked="{Binding IsExpanded}" Style="{StaticResource PoolExpander}" ToolTip="展开或收起统计" /><StackPanel Grid.Column="1" Orientation="Horizontal"><ToggleButton Content="&#xE8A4;" FontFamily="Segoe MDL2 Assets" IsChecked="{Binding IsUpCycle}" Style="{StaticResource LayoutToggle}" Margin="0,0,5,0" Visibility="{Binding SupportsUpCycle, Converter={StaticResource Visible}}" ToolTip="合并非 UP：将非 UP 抽数累计到下一次 UP，未知排期保留" AutomationProperties.Name="合并非 UP 周期"/><ToggleButton IsChecked="{Binding IsGridLayout}" ToolTip="切换五星列表 / 网格" AutomationProperties.Name="切换出金列表或网格"><ToggleButton.Style><Style TargetType="ToggleButton" BasedOn="{StaticResource LayoutToggle}"><Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="Content" Value="&#xE80A;"/><Style.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="Content" Value="&#xEA37;"/></Trigger></Style.Triggers></Style></ToggleButton.Style></ToggleButton></StackPanel></Grid>
   </Border>
   <controls:AnimatedReveal Grid.Row="1" IsExpanded="{Binding IsExpanded}"><StackPanel Margin="16,15,16,0">
    <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding TotalText}" FontSize="44" FontWeight="SemiBold" FontFamily="Segoe UI" /><TextBlock Text="抽" Foreground="{DynamicResource Muted}" Margin="8,0,0,8" VerticalAlignment="Bottom" /></StackPanel>
    <Grid Margin="0,10,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="五星进度" FontSize="12" Foreground="{DynamicResource QualityGold}" /><TextBlock Text="{Binding PityText}" FontSize="14" Margin="0,5,0,7" /><ProgressBar Value="{Binding PityValue, Mode=OneWay}" Maximum="{Binding HardPity}" Foreground="#D0AA70" Height="4" /></StackPanel>
     <StackPanel Grid.Column="2"><TextBlock Text="四星进度" FontSize="12" Foreground="{DynamicResource Gold}" ToolTip="距离上次四星的档案抽数，五星不会重置此计数。"/><TextBlock Text="{Binding FourStarText}" FontSize="14" Margin="0,5,0,7" /><ProgressBar Value="{Binding FourStarPity, Mode=OneWay}" Maximum="10" Foreground="#AF96CE" Height="4" /></StackPanel>
    </Grid>
    <TextBlock Text="{Binding Guarantee}" FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" /><TextBlock Text="{Binding DateRange}" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,7,0,10" />
    <ItemsControl ItemsSource="{Binding MetricTabs}" Margin="0,4,0,10"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Name}" Style="{StaticResource SectionTab}" Padding="5,8" FontSize="13" Command="{Binding DataContext.MetricCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <Grid x:Name="MetricsPanel" Height="82" Margin="0,0,0,7">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition><ColumnDefinition.Style><Style TargetType="ColumnDefinition"><Setter Property="Width" Value="*"/><Style.Triggers><DataTrigger Binding="{Binding ShowRightMetric}" Value="False"><Setter Property="Width" Value="0"/></DataTrigger></Style.Triggers></Style></ColumnDefinition.Style></ColumnDefinition><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border x:Name="AverageTile" Background="{DynamicResource PanelRaised}" CornerRadius="8" Margin="0,0,6,0"><Viewbox StretchDirection="DownOnly" Margin="5"><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding LeftLabel}" Foreground="{DynamicResource Muted}" FontSize="12" HorizontalAlignment="Center"/><TextBlock Text="{Binding LeftMetric}" FontSize="21" HorizontalAlignment="Center" Margin="0,7,0,0"/></StackPanel></Viewbox></Border>
     <Border x:Name="UpAverageTile" Grid.Column="1" Background="{DynamicResource PanelRaised}" CornerRadius="8" Margin="0,0,6,0" Visibility="{Binding ShowRightMetric, Converter={StaticResource Visible}}"><Viewbox StretchDirection="DownOnly" Margin="5"><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding RightLabel}" Foreground="{DynamicResource Muted}" FontSize="12" HorizontalAlignment="Center"/><TextBlock Text="{Binding RightMetric}" FontSize="21" HorizontalAlignment="Center" Margin="0,7,0,0"/></StackPanel></Viewbox></Border>
     <Grid x:Name="ExtremaColumn" Grid.Column="2"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="6"/><RowDefinition/></Grid.RowDefinitions>
      <Button Command="{Binding AnchorCommand}" CommandParameter="min" Padding="6,5" HorizontalContentAlignment="Stretch" ToolTip="定位到最欧记录"><Viewbox StretchDirection="DownOnly"><StackPanel Orientation="Horizontal"><TextBlock Text="✧ 最欧" Foreground="{DynamicResource Muted}" FontSize="13" VerticalAlignment="Center"/><TextBlock Text="{Binding LuckiestText}" FontSize="13" Margin="6,0,0,0" VerticalAlignment="Center"/></StackPanel></Viewbox></Button>
      <Button Grid.Row="2" Command="{Binding AnchorCommand}" CommandParameter="max" Padding="6,5" HorizontalContentAlignment="Stretch" ToolTip="定位到最非记录"><Viewbox StretchDirection="DownOnly"><StackPanel Orientation="Horizontal"><TextBlock Text="✦ 最非" Foreground="{DynamicResource Muted}" FontSize="13" VerticalAlignment="Center"/><TextBlock Text="{Binding MostUnluckyText}" FontSize="13" Margin="6,0,0,0" VerticalAlignment="Center"/></StackPanel></Viewbox></Button>
     </Grid>
    </Grid>
   </StackPanel></controls:AnimatedReveal>
   <Grid Grid.Row="2" Margin="10,12,10,0"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <TextBlock Text="{Binding GoldCaption}" FontSize="12" Foreground="{DynamicResource Muted}" Margin="7,0,0,10" />
    <TextBlock Grid.Row="1" Text="尚未记录五星相遇" Foreground="{DynamicResource Muted}" FontSize="14" Margin="8,12" Visibility="{Binding HasGold, Converter={StaticResource Visible}, ConverterParameter=Invert}" />
    <ListBox x:Name="GoldList" Grid.Row="1" ItemsSource="{Binding GoldItems}" ItemTemplate="{StaticResource GoldListItem}" Visibility="{Binding IsGridLayout, Converter={StaticResource Visible}, ConverterParameter=Invert}" />
    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" ScrollChanged="GridScrollChanged" Visibility="{Binding IsGridLayout, Converter={StaticResource Visible}}"><ItemsControl x:Name="GoldGrid" ItemsSource="{Binding GridGoldItems}" ItemTemplate="{StaticResource GoldGridItem}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl></ScrollViewer>
   </Grid>
   <Border Grid.Row="3" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="16,8"><Button Content="查看详细  →" Style="{StaticResource LinkButton}" Command="{Binding DataContext.Shell.DetailCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" FontSize="14" /></Border>
  </Grid>
 </Border>
</UserControl>

