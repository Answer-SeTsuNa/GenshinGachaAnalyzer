<Application x:Class="GenshinGachaAnalyzer.WPF.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="clr-namespace:GenshinGachaAnalyzer.WPF.ViewModels"
 xmlns:views="clr-namespace:GenshinGachaAnalyzer.WPF.Views">
 <Application.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Resources/Styles.xaml" /><ResourceDictionary Source="Resources/WishTemplates.xaml" /><ResourceDictionary Source="Resources/InteractionStyles.xaml" /></ResourceDictionary.MergedDictionaries>
   <DataTemplate DataType="{x:Type vm:WelcomeViewModel}"><views:WelcomeView /></DataTemplate>
   <DataTemplate DataType="{x:Type vm:DatabaseUnavailableViewModel}">
    <Grid><Border Style="{StaticResource Card}" MaxWidth="780" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel>
     <TextBlock Text="⚠ 本地档案未能加载" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource Error}"/>
     <TextBlock Text="当前无法读取账号与记录，页面空白不代表数据已被删除。" TextWrapping="Wrap" Margin="0,18,0,12"/>
     <TextBlock Text="{Binding Shell.Status}" TextWrapping="Wrap" Margin="0,0,0,18"/>
     <TextBlock Text="原始数据库位置" Style="{StaticResource MutedText}"/>
     <TextBlock Text="{Binding Shell.DatabasePath}" TextWrapping="Wrap" Margin="0,6,0,20"/>
     <WrapPanel><Button Content="↻ 重试加载" Command="{Binding Shell.RetryCommand}" Margin="0,0,12,8"/>
      <Button Content="▤ 查看诊断信息" Command="{Binding Shell.DeveloperLogCommand}" Margin="0,0,12,8"/>
      <Button Content="▧ 打开数据目录" Command="{Binding Shell.OpenDataCommand}" Margin="0,0,0,8"/></WrapPanel>
     <TextBlock Text="请保留原文件与 backups 文件夹。重新导入或清空账号不能解决访问权限问题。" TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,12,0,0"/>
    </StackPanel></Border></Grid>
   </DataTemplate>
   <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><views:DashboardView /></DataTemplate>
   <DataTemplate DataType="{x:Type vm:DetailViewModel}"><views:DetailView /></DataTemplate>
   <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView /></DataTemplate>
   <DataTemplate DataType="{x:Type vm:HistoryViewModel}"><views:HistoryView /></DataTemplate>
   <DataTemplate DataType="{x:Type vm:CollectionViewModel}"><views:CollectionView /></DataTemplate>
   <DataTemplate DataType="{x:Type vm:CountdownViewModel}"><views:CountdownView /></DataTemplate>
   <DataTemplate DataType="{x:Type vm:PersonalViewModel}"><views:PersonalView/></DataTemplate>
   <DataTemplate DataType="{x:Type vm:LoadingViewModel}"><Grid><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="{Binding Message}" FontSize="22" Foreground="{DynamicResource Gold}"/><ProgressBar IsIndeterminate="True" Width="260" Margin="0,20,0,0"/></StackPanel></Grid></DataTemplate>
  </ResourceDictionary>
 </Application.Resources>
</Application>
